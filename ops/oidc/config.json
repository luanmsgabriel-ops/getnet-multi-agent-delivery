{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "getnet",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${clientId}",
            "aud": ["getnet-chat"],
            "scope": "${scope}",
            "tenant": "demo"
          }
        }
      ]
    }
  ]
}
