.env
.venv/
__pycache__/
/historico/

# Evitar publicar arquivos locais e segredos por variantes de nome.
.env.*
!.env.example
_backups/
*.pyc
.pytest_cache/
*.log
_repro/

_delivery/
_auditoria_independente/
_correcoes/

# Evidências e ambientes da conclusão técnica permanecem locais.
_conclusao/
_auditoria_aderencia/
_auditoria_adversarial/
