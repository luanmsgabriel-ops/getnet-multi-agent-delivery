# Artefatos locais de execução e verificação; evidências revisadas ficam em docs/.
_local/
*.db
*.db-*
*.sqlite*
*.key

# Somente logs revisados de evidência; logs de execução continuam ignorados.
!docs/historico/**/*.log
!docs/evidence/entrega-20261110/*.log
