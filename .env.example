# Copy to .env (`make setup` does it and generates JWT_SECRET for you).

# LLM provider key. Without it /chat answers 503 and /ready reports llm=false.
ANTHROPIC_API_KEY=

# Secret used to sign API tokens (>= 32 chars). `make setup` fills it in.
JWT_SECRET=

# Optional tuning
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# Signs handoff notifications (HMAC-SHA256). `make setup` fills it in.
WEBHOOK_SECRET=

# Optional Telegram channel for operators (docs/HITL.md): a bot token from @BotFather and the
# operator chat ids (comma-separated). Leave empty to use only the console and the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_IDS=

# Password of the compose Postgres that holds app state. `make setup` fills it in.
POSTGRES_PASSWORD=

# Model for all agents (measured trade-off in docs/adr/008) and the hard spend cap in USD.
LLM_MODEL=claude-sonnet-5-5
LLM_BUDGET_USD=10

# Evals only: independent judge via OpenRouter (python -m evals.judge).
OPENROUTER_API_KEY=
JUDGE_MODEL=openai/gpt-5-mini
