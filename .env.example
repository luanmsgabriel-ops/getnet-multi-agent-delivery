# Optional local template. Compose does not pass .env to the server; Compose itself may read it for interpolation. Never overwrite existing configuration.
# Local authentication is required by default; never use an OpenRouter/Getnet key here.
# Initialize the local registry with app.access_admin; see docs/LOCAL_ACCESS.md.
GETNET_AUTH_MODE=required
# Set an absolute path OUTSIDE the repository and cloud-sync folders.
GETNET_AUTH_DB=
GETNET_RATE_PER_MINUTE=30
GETNET_RATE_GLOBAL_PER_MINUTE=180
# For explicitly anonymous local fixtures only: GETNET_AUTH_MODE=demo.
# Invalid/missing credentials never downgrade required mode to demo.

# Padrão sem LLM; supervisor exige ativação, configuração e orçamento explícitos.
GETNET_ORCHESTRATION=deterministic
GETNET_ALLOW_MODEL_NETWORK=0
# Sintese opt-in: ate tres chamadas (plano, redacao, checagem), no ledger do supervisor.
# disabled nao gera chamadas extras; validated exige autorizacao/orcamento explicitos.
GETNET_RAG_GENERATION=disabled
# Supervisor: configure somente após autorização de chamadas de teste.
GETNET_SUPERVISOR_MODEL=openai/gpt-6-sol
GETNET_SUPERVISOR_PRICES=
GETNET_SUPERVISOR_LEDGER=
GETNET_SUPERVISOR_MAX_CALLS=40
GETNET_SUPERVISOR_COST_CAP=1.00
# Brave real bloqueado sem orcamento equivalente; chave nao remove o bloqueio.
GETNET_PUBLIC_SEARCH=disabled
# Mwmbl: demonstração não comercial, anônima; 50 tentativas/mês no contador local.
# Alternativas: mwmbl experimental ou disabled. Brave real bloqueado; Tavily pausado. Sem failover.
# GETNET_PUBLIC_SEARCH_LEDGER=/tmp/getnet-challenge/mwmbl-usage.db
BRAVE_SEARCH_API_KEY=
# Tavily pausado nesta rodada; eventual ativacao exige autorizacao separada. Nunca cole chave aqui.
TAVILY_API_KEY=
# GETNET_PUBLIC_SEARCH=tavily
# GETNET_TAVILY_LEDGER=/tmp/getnet-challenge/tavily-budget.db
# Modelos reais legados bloqueados; somente supervisor canonico com ledger explicito.
OPENROUTER_API_KEY=
GETNET_CONTEXT_MODEL=0
GETNET_MODEL=openai/gpt-6-sol
GETNET_WEB_SEARCH=0
# Local: configure caminho persistente fora do repositorio. Compose fixa /state/local/state.db.
# GETNET_CONTEXT_DB=/tmp/getnet-context/state.db
GETNET_PRICE_FILE=
GETNET_COST_LEDGER=
GETNET_MAX_CALLS=40
GETNET_COST_CAP=1.00

# Adaptador documental local; legacy e lexical sao escolhas explicitas.
GETNET_RAG_ADAPTER=documentary
GETNET_RAG_RETRIEVAL=lexical
# Obrigatorio somente para semantic; provisionar modelo fixado fora do repositorio.
GETNET_LOCAL_EMBEDDING_DIR=

# Protocolo exclusivamente local/sintetico, desligado por padrao.
GETNET_DEMO_TICKETS=0
# Obrigatorio quando habilitado: arquivo SQLite gravavel fora do repositorio.
GETNET_DEMO_TICKET_DB=
