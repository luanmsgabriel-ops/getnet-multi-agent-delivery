# Getnet Brasil. Modelo contextual opcional; chave somente no ambiente, nunca no build.
OPENROUTER_API_KEY=
GETNET_CONTEXT_MODEL=0
GETNET_MODEL=openai/gpt-6-sol
GETNET_WEB_SEARCH=0
# Opcional: omita para o default Docker; no Windows, defina um caminho gravável.
# GETNET_CONTEXT_DB=/tmp/getnet-context/state.db
GETNET_PRICE_FILE=
GETNET_COST_LEDGER=
GETNET_MAX_CALLS=40
GETNET_COST_CAP=1.00
